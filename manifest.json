{
  "manifest_version": 3,
  "name": "bilibili-视频记录",
  "version": "2.0.0",
  "description": "记录播放列表和观看历史，提供视频记录功能。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["*://*.bilibili.com/*"],
    "js": ["shared.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "permissions": ["storage", "activeTab", "system.display", "windows"],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://space.bilibili.com/*",
    "https://api.bilibili.com/*"
  ]
}